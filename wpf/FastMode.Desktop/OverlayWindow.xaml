<Window x:Class="FastMode.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMode Overlay"
        Width="36" Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Border x:Name="Root" Background="#3F9D6A" CornerRadius="6" BorderBrush="#2F7A52" BorderThickness="1"
          MouseLeftButtonDown="Root_MouseLeftButtonDown" Cursor="SizeAll">
    <TextBlock x:Name="TxtState" Text="Off" Foreground="White" FontWeight="Bold" FontSize="11"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
</Window>
