<Window x:Class="FastMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMode"
        Width="440" Height="720"
        MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button x:Name="BtnSettings" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="设置" Click="BtnSettings_Click"/>
      <StackPanel>
        <TextBlock Text="FastMode" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="原生桌面加速控制（PCL 风格）" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource CardBorder}" x:Name="BannerError" Visibility="Collapsed" Background="#FFF1F0" BorderBrush="#F3C1C1">
          <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- Process -->
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="BtnRefresh_Click"/>
              <TextBlock Text="目标进程" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="TxtSearch" Style="{StaticResource FieldTextBox}" Margin="0,10,0,8"
                     TextChanged="TxtSearch_TextChanged" Tag="搜索进程名…"/>
            <ListBox x:Name="ListProcesses" Height="150" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Background="#FBFCFB" MouseDoubleClick="ListProcesses_MouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" Margin="4,3"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Margin="0,10,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="断开" Click="BtnDetach_Click" x:Name="BtnDetach"/>
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="附加" Margin="0,0,8,0" Click="BtnAttach_Click" x:Name="BtnAttach"/>
              <TextBlock x:Name="TxtAttach" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="未附加"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Speed -->
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <DockPanel>
              <CheckBox x:Name="ChkEnable" DockPanel.Dock="Right" Content="启用加速" VerticalAlignment="Center" Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
              <StackPanel>
                <TextBlock Text="加速" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="启用后按当前倍速生效；关闭回到 1.0x" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="倍速" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6" FontSize="12"/>
            <WrapPanel x:Name="PanelPresets"/>
            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="应用" Click="BtnApplySpeed_Click"/>
              <TextBox x:Name="TxtCustomSpeed" Style="{StaticResource FieldTextBox}" Margin="0,0,8,0" Width="Auto"/>
            </DockPanel>
            <TextBlock x:Name="TxtSpeedState" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <!-- Window -->
        <Border Style="{StaticResource CardBorder}">
          <DockPanel>
            <CheckBox x:Name="ChkTopmost" DockPanel.Dock="Right" Content="始终置顶" VerticalAlignment="Center" Checked="ChkTopmost_Changed" Unchecked="ChkTopmost_Changed"/>
            <StackPanel>
              <TextBlock Text="窗口" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="置顶后方便边玩边看状态" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Gamepad -->
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="修改快捷键" Click="BtnHotkey_Click"/>
              <StackPanel>
                <TextBlock Text="手柄" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="TxtGamepad" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="未连接"/>
                <TextBlock x:Name="TxtHotkey" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" x:Name="TxtStatus" Margin="2,10,2,0" Foreground="{StaticResource MutedBrush}" Text="就绪"/>
  </Grid>
</Window>
