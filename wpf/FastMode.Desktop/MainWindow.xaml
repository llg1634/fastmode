<Window x:Class="FastMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMode"
        Width="820" Height="560"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid x:Name="RootChrome" Margin="10">
    <!-- Outer soft shadow like PCL shell -->
    <Border Background="#01000000" CornerRadius="8" Margin="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" Color="#343D4A"/>
      </Border.Effect>
    </Border>

    <Border x:Name="ShellBorder" Background="{StaticResource ColorBrushBgContent}" CornerRadius="6" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- PCL-like title bar -->
        <Border Grid.Row="0" x:Name="TitleBar" Background="{StaticResource ColorBrush4}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid Margin="12,0,8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="FastMode" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="加速" Foreground="#CCFFFFFF" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
              <CheckBox x:Name="ChkTopmost" Style="{StaticResource MiniSwitch}" Content="置顶" Margin="0,0,14,0"
                        Checked="ChkTopmost_Changed" Unchecked="ChkTopmost_Changed"/>
              <Border Background="#22FFFFFF" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="TxtGamepad" Text="手柄未连接" Foreground="#E6FFFFFF" FontSize="11"/>
                    <TextBlock x:Name="TxtHotkey" Text="LB + RB" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </StackPanel>
                  <Button x:Name="BtnHotkey" Content="改键" Style="{StaticResource TitleIconButton}" Width="Auto" Padding="8,0"
                          Foreground="White" Click="BtnHotkey_Click" FontSize="11"/>
                </StackPanel>
              </Border>
              <Button x:Name="BtnSettings" Content="设置" Style="{StaticResource TitleIconButton}" Width="Auto" Padding="10,0"
                      Foreground="White" Click="BtnSettings_Click" FontSize="12"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnMin" Style="{StaticResource TitleIconButton}" Click="BtnMin_Click" ToolTip="最小化">
                <Path Stroke="White" StrokeThickness="1.6" Data="M4,14 H18" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button x:Name="BtnClose" Style="{StaticResource TitleIconButton}" Margin="0" Click="BtnClose_Click" ToolTip="关闭">
                <Path Stroke="White" StrokeThickness="1.6" Data="M4,4 L14,14 M14,4 L4,14" Width="12" Height="12" Stretch="Uniform"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Process card -->
          <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="BtnRefresh_Click"/>
                <TextBlock Text="目标进程" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource ColorBrush1}" VerticalAlignment="Center"/>
              </DockPanel>

              <TextBox Grid.Row="1" x:Name="TxtSearch" Style="{StaticResource FieldTextBox}" Margin="0,10,0,8"
                       TextChanged="TxtSearch_TextChanged" ToolTip="搜索窗口标题 / 进程名"/>

              <ListBox Grid.Row="2" x:Name="ListProcesses"
                       BorderBrush="{StaticResource ColorBrush6}" BorderThickness="1"
                       Background="{StaticResource ColorBrush8}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       MouseDoubleClick="ListProcesses_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="Height" Value="42"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush7}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush6}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                             Source="{Binding Icon}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource ColorBrush1}"/>
                        <TextBlock Text="{Binding DisplaySecondary}" Foreground="{StaticResource ColorBrushGray3}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="断开" Click="BtnDetach_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="附加" Margin="0,0,8,0" Click="BtnAttach_Click"/>
                <TextBlock x:Name="TxtAttach" Foreground="{StaticResource ColorBrushGray3}" VerticalAlignment="Center"
                           Text="未附加" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Grid>
          </Border>

          <!-- Speed card -->
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel>
                <CheckBox x:Name="ChkEnable" DockPanel.Dock="Right" Style="{StaticResource MiniSwitch}" Content="启用"
                          Foreground="{StaticResource ColorBrush1}"
                          Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                <TextBlock Text="加速" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource ColorBrush1}" VerticalAlignment="Center"/>
              </DockPanel>

              <TextBlock Text="倍速" Foreground="{StaticResource ColorBrushGray3}" Margin="0,16,0,8" FontSize="12"/>
              <WrapPanel x:Name="PanelPresets"/>
              <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="应用" Click="BtnApplySpeed_Click"/>
                <TextBox x:Name="TxtCustomSpeed" Style="{StaticResource FieldTextBox}" Margin="0,0,8,0"/>
              </DockPanel>
              <TextBlock x:Name="TxtSpeedState" Foreground="{StaticResource ColorBrushGray3}" FontSize="12" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Fixed bottom status -->
        <Border Grid.Row="2" Background="{StaticResource ColorBrush8}" BorderBrush="{StaticResource ColorBrush6}" BorderThickness="0,1,0,0">
          <TextBlock x:Name="TxtStatus" Text="就绪" Margin="14,0" VerticalAlignment="Center" FontSize="12"
                     Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
    </Border>

    <!-- Resize grips (PCL-like) -->
    <Rectangle x:Name="ResizeN" Height="6" VerticalAlignment="Top" Margin="12,0" Fill="Transparent" Cursor="SizeNS"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="N"/>
    <Rectangle x:Name="ResizeS" Height="6" VerticalAlignment="Bottom" Margin="12,0" Fill="Transparent" Cursor="SizeNS"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="S"/>
    <Rectangle x:Name="ResizeW" Width="6" HorizontalAlignment="Left" Margin="0,12" Fill="Transparent" Cursor="SizeWE"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="W"/>
    <Rectangle x:Name="ResizeE" Width="6" HorizontalAlignment="Right" Margin="0,12" Fill="Transparent" Cursor="SizeWE"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="E"/>
    <Rectangle x:Name="ResizeNW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="NW"/>
    <Rectangle x:Name="ResizeNE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="NE"/>
    <Rectangle x:Name="ResizeSW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="SW"/>
    <Rectangle x:Name="ResizeSE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE"
               PreviewMouseLeftButtonDown="Resize_MouseDown" Tag="SE"/>
  </Grid>
</Window>
