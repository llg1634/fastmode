<Window x:Class="FastMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMode"
        Width="440" Height="620"
        MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
  <Grid Margin="14,12,14,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="FastMode" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="加速控制" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,1,0,0"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="ChkTopmost" Style="{StaticResource MiniSwitch}" Content="置顶"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  Checked="ChkTopmost_Changed" Unchecked="ChkTopmost_Changed"/>

        <Border Background="#EEF3F0" CornerRadius="10" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock x:Name="TxtGamepad" Text="手柄未连接" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="BtnHotkey" Content="改键" Padding="6,1" Margin="8,0,0,0"
                      Style="{StaticResource GhostButton}" FontSize="11" Click="BtnHotkey_Click"/>
              <TextBlock x:Name="TxtHotkey" Text="切换键：LB + RB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Button x:Name="BtnSettings" Style="{StaticResource GhostButton}" Content="设置" Click="BtnSettings_Click"/>
      </StackPanel>
    </Grid>

    <!-- Main: only two cards, no page scrollbar -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="1.35*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Process -->
      <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="BtnRefresh_Click"/>
            <TextBlock Text="目标进程" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          </DockPanel>

          <TextBox Grid.Row="1" x:Name="TxtSearch" Style="{StaticResource FieldTextBox}" Margin="0,10,0,8"
                   TextChanged="TxtSearch_TextChanged" ToolTip="搜索窗口标题 / 进程名"/>

          <ListBox Grid.Row="2" x:Name="ListProcesses"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                   Background="#FBFCFB"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MouseDoubleClick="ListProcesses_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Image Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                         Source="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DisplaySecondary}" Foreground="#8A9A91" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="断开" Click="BtnDetach_Click" x:Name="BtnDetach"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="附加" Margin="0,0,8,0" Click="BtnAttach_Click" x:Name="BtnAttach"/>
            <TextBlock x:Name="TxtAttach" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="未附加" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </Border>

      <!-- Speed -->
      <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0">
        <StackPanel>
          <DockPanel>
            <CheckBox x:Name="ChkEnable" DockPanel.Dock="Right" Style="{StaticResource MiniSwitch}" Content="启用"
                      VerticalAlignment="Center" Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
            <TextBlock Text="加速" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          </DockPanel>

          <TextBlock Text="倍速" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6" FontSize="12"/>
          <WrapPanel x:Name="PanelPresets"/>
          <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="应用" Click="BtnApplySpeed_Click"/>
            <TextBox x:Name="TxtCustomSpeed" Style="{StaticResource FieldTextBox}" Margin="0,0,8,0"/>
          </DockPanel>
          <TextBlock x:Name="TxtSpeedState" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- spacer row unused intentionally kept compact -->
    <Border Grid.Row="2" Height="0"/>

    <!-- Fixed bottom status bar: never reflows main content -->
    <Border Grid.Row="3" Background="#EEF3F0" CornerRadius="8" Padding="10,0" VerticalAlignment="Stretch">
      <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>
