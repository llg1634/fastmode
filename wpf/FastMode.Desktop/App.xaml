<Application x:Class="FastMode.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Strings.zh-CN.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Green design language (product requirement), scaled like a real token set -->
      <Color x:Key="ColorObject1">#1F3B2E</Color>
      <Color x:Key="ColorObject2">#2F7A52</Color>
      <Color x:Key="ColorObject3">#3F9D6A</Color>
      <Color x:Key="ColorObject4">#57B37F</Color>
      <Color x:Key="ColorObject5">#9FD5B5</Color>
      <Color x:Key="ColorObject6">#D7F0E3</Color>
      <Color x:Key="ColorObject7">#E7F6EE</Color>
      <Color x:Key="ColorObject8">#F3FAF6</Color>

      <SolidColorBrush x:Key="ColorBrush1" Color="{StaticResource ColorObject1}"/>
      <SolidColorBrush x:Key="ColorBrush2" Color="{StaticResource ColorObject2}"/>
      <SolidColorBrush x:Key="ColorBrush3" Color="{StaticResource ColorObject3}"/>
      <SolidColorBrush x:Key="ColorBrush4" Color="{StaticResource ColorObject4}"/>
      <SolidColorBrush x:Key="ColorBrush5" Color="{StaticResource ColorObject5}"/>
      <SolidColorBrush x:Key="ColorBrush6" Color="{StaticResource ColorObject6}"/>
      <SolidColorBrush x:Key="ColorBrush7" Color="{StaticResource ColorObject7}"/>
      <SolidColorBrush x:Key="ColorBrush8" Color="{StaticResource ColorObject8}"/>

      <SolidColorBrush x:Key="ColorBrushGray1" Color="#404040"/>
      <SolidColorBrush x:Key="ColorBrushGray2" Color="#5B6B63"/>
      <SolidColorBrush x:Key="ColorBrushGray3" Color="#8A9A91"/>
      <SolidColorBrush x:Key="ColorBrushGray4" Color="#A6B3AC"/>
      <SolidColorBrush x:Key="ColorBrushGray5" Color="#CDD6D1"/>
      <SolidColorBrush x:Key="ColorBrushGray6" Color="#E4EBE7"/>
      <SolidColorBrush x:Key="ColorBrushGray7" Color="#EEF3F0"/>
      <SolidColorBrush x:Key="ColorBrushGray8" Color="#F6F8F7"/>

      <SolidColorBrush x:Key="ColorBrushWhite" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ColorBrushRedLight" Color="#FF4C4C"/>
      <SolidColorBrush x:Key="ColorBrushRedDark" Color="#CE2111"/>
      <SolidColorBrush x:Key="ColorBrushBgContent" Color="#F4F7F5"/>

      <SolidColorBrush x:Key="BgBrush" Color="#F4F7F5"/>
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFF5"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#B7D9C6"/>
      <SolidColorBrush x:Key="TextBrush" Color="#1F3B2E"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#8A9A91"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#3F9D6A"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F6EE"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#CE2111"/>

      <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
      </Style>

      <!-- Rounded card with visible border -->
      <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFFF8"/>
        <Setter Property="BorderBrush" Value="#B7D9C6"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.10" Color="#1F3B2E"/>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ColorBrush3}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush2}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/>
        <Setter Property="BorderBrush" Value="#B7D9C6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush7}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ColorBrush4}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="TitleIconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" CornerRadius="8" Width="28" Height="28">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ChipButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ColorBrush8}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/>
        <Setter Property="BorderBrush" Value="#B7D9C6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush7}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ColorBrush3}"/>
                  <Setter Property="Foreground" Value="{StaticResource ColorBrush2}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ColorBrush4}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#B7D9C6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource ColorBrush8}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ColorBrush3}"/>
                  <Setter TargetName="bd" Property="Background" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="MiniSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="track" Width="36" Height="18" CornerRadius="9"
                        Background="#55FFFFFF" BorderBrush="#B7D9C6" BorderThickness="1"
                        VerticalAlignment="Center">
                  <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                </Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="track" Property="Background" Value="#EEFFFFFF"/>
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource ColorBrush3}"/>
                  <Setter TargetName="thumb" Property="Fill" Value="{StaticResource ColorBrush3}"/>
                  <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SettingsNavItem" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,10">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush7}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource ColorBrush6}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Foreground" Value="{StaticResource ColorBrush2}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PadKey" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#B7D9C6"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2" CornerRadius="6" Padding="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PadKeyRound" TargetType="Button" BasedOn="{StaticResource PadKey}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2" CornerRadius="999">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="KeyboardKey" TargetType="Button" BasedOn="{StaticResource PadKey}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,7,7"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>


